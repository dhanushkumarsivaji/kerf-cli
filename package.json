{
  "name": "kerf-cli",
  "version": "3.3.1",
  "type": "module",
  "description": "Cost intelligence for your AI coding agents (Claude Code, Codex CLI, and more). Know before you spend.",
  "bin": {
    "kerf": "./dist/index.js",
    "kerf-cli": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "docs/assets/dashboard.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhanushkumarsivaji/kerf-cli.git"
  },
  "homepage": "https://github.com/dhanushkumarsivaji/kerf-cli#readme",
  "bugs": {
    "url": "https://github.com/dhanushkumarsivaji/kerf-cli/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "ai-coding",
    "token-optimization",
    "cost-intelligence",
    "developer-tools",
    "cli",
    "kerf",
    "typescript"
  ],
  "author": "Dhanush Kumar Sivaji",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "chalk": "5.4.1",
    "chokidar": "4.0.3",
    "commander": "13.1.0",
    "dayjs": "1.11.13",
    "glob": "11.0.1",
    "ink": "5.2.0",
    "ora": "8.2.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.12.0",
    "@types/react": "18.3.18",
    "ink-testing-library": "4.0.0",
    "tsup": "8.4.0",
    "typescript": "5.8.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
